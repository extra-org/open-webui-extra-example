# Copy to .env and fill in. Never commit the real .env.

ANTHROPIC_API_KEY=

# Open WebUI's own API base, reachable from wherever Extra runs.
OPEN_WEBUI_URL=http://localhost:8080

# Extra verifies Open WebUI's session JWT directly, so this must be the same
# secret Open WebUI signs with: its WEBUI_SECRET_KEY.
AGENT_AUTH_MODE=host_token
AGENT_AUTH_SECRET=
AGENT_AUTH_CLAIM_USER_ID=id

# Open WebUI's own origin, so the embedded widget's requests are allowed.
CORS_ORIGINS=http://localhost:8080
