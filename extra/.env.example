# Copy to .env and fill in. Never commit the real .env. See the README's
# "Environment" section for where each value comes from.

ANTHROPIC_API_KEY=

# For a local Ollama model instead — no paid key needed — set provider: openai
# in agents.yml (see its comment) and use these two instead of the Anthropic
# key above:
#     ollama pull qwen2.5:14b
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Open WebUI's backend, reachable from wherever Extra runs.
OPEN_WEBUI_URL=http://localhost:8080

# token-url points the widget at Open WebUI's own /auths/agent-chat/token —
# a dedicated, short-lived (5 min) token minted for the assistant, not the
# user's regular session. That's what `mint` means: caps how long a token we
# accept can live (AGENT_AUTH_MAX_TTL_SECONDS, 1h default) and requires an
# expiry at all, rather than trusting whatever the host's token declares.
# Signed with the same secret either way — must be the exact value of Open
# WebUI's own WEBUI_SECRET_KEY (backend/.env.example ships it already).
AGENT_AUTH_MODE=mint
AGENT_AUTH_SECRET=pLiUxoi+ziwTUIhNhVg/AN1U50UMom00
AGENT_AUTH_CLAIM_USER_ID=id
# admin_management is a protected node (see plugins/access.py) — this is the
# claim it reads to decide who gets to see it at all.
AGENT_AUTH_CLAIM_ROLES=role

# The origin the browser loads the page from — where the widget script
# actually runs, not where Open WebUI's backend answers API calls. In dev
# that's the Vite frontend server, not the backend port.
CORS_ORIGINS=http://localhost:5173
